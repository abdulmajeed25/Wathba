# Wathba API — environment template
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (pgvector + pgcrypto extensions)
DATABASE_URL=postgresql://wathba:wathba@localhost:5432/wathba?schema=public

# Redis (BullMQ + cache)
REDIS_URL=redis://localhost:6379

# JWT — must be a strong random string ≥16 chars. Boot validation
# (IdentityModule + JwtStrategy) throws if missing, too short, or a
# placeholder like 'change-me'. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_BASE64URL_STRING_BEFORE_BOOTING
JWT_EXPIRES_IN=1h

# Nafath (KYC) — Phase 1 stub
NAFATH_BASE_URL=https://nafath.example.test
NAFATH_API_KEY=

# Moyasar Split (escrow)
MOYASAR_API_KEY=
MOYASAR_PUBLIC_KEY=
MOYASAR_WEBHOOK_SECRET=

# ZATCA Phase 2 (e-invoicing on platform commission only)
ZATCA_BASE_URL=
ZATCA_TENANT_ID=


# Payout provider (Sprint 5 / #4) — creator disbursement. When KEY is unset the
# disburser runs in stub mode; when set it POSTs to PROVIDER_URL with an
# Idempotency-Key of payout-<id>.
PAYOUT_PROVIDER_KEY=
PAYOUT_PROVIDER_URL=https://api.moyasar.com/v1/payouts
# Wathba's Moyasar payout SOURCE account id (create once in the dashboard).
MOYASAR_PAYOUT_SOURCE_ID=
# Moyasar payout purpose enum (e.g. expenses_services, bills_or_rent).
MOYASAR_PAYOUT_PURPOSE=expenses_services
