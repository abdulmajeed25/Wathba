// Wathba domain schema (Prisma).
// All money in BigInt halalas (100 halalas = 1 SAR). Never floats.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CREATOR
  BACKER
  SUPPLIER
  ADMIN
}

enum ReputationTier {
  NEWCOMER
  SUPPORTER
  ADVOCATE
  AMBASSADOR
  FOUNDER
}

enum ProjectCategory {
  TECH
  DESIGN
  FILM
  MUSIC
  FOOD
  GAMES
  PUBLISHING
  FASHION
  ART
  SOCIAL
}

enum ProjectStatus {
  DRAFT
  UNDER_REVIEW
  LIVE
  PAUSED
  SUCCESSFUL
  FAILED
  FUNDED
  IN_PRODUCTION
  DELIVERED
  REFUNDED
}

enum PledgeStatus {
  HELD
  CAPTURED
  REFUNDED
  FAILED
  DISPUTED
}

/// Creator-editable fulfillment bookkeeping on a pledge (Creator-CC / CC-02).
/// PURELY informational — has NO money effect and never gates refunds or
/// payouts. Lets a creator track which rewards have shipped (KS "Status"
/// column parity).
enum RewardFulfillmentStatus {
  PENDING
  IN_PROGRESS
  SENT
}

enum ContractType {
  DONATION
  ISTISNA
  SALAM
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  RELEASED
}

enum RFQStatus {
  OPEN
  AWARDED
  CLOSED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  SHORTLISTED
  AWARDED
  REJECTED
}

enum PayoutStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationKind {
  PLEDGE_RECEIVED
  PROJECT_FUNDED
  PROJECT_FAILED
  MILESTONE_APPROVED
  PAYOUT_SENT
  UPDATE_POSTED
  RANK_UP
  CONTEST_OPENED
  CONTEST_ANNOUNCED
  FAQ_ANSWERED
  COMMENT_REPLY
  PROJECT_REVIEWED
}

enum ContestStatus {
  DRAFT
  OPEN
  CLOSED
  ANNOUNCED
}

enum FaqQuestionStatus {
  PENDING
  ANSWERED
  HIDDEN
}

enum CommunityStatScope {
  CITY
  COUNTRY
  TOTALS
}

/// Project-update audience (Creator-CC / CC-12). BACKERS_ONLY updates are only
/// visible to users with a CAPTURED pledge on the project (policy §9).
enum UpdateVisibility {
  PUBLIC
  BACKERS_ONLY
}

// ============================================================================
// IDENTITY
// ============================================================================

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  email               String          @unique
  phone               String?
  passwordHash        String?
  roles               UserRole[]      @default([BACKER])
  nafathVerified      Boolean         @default(false)
  nafathVerifiedAt    DateTime?
  /// PDPL (Sprint 2 / P0-702): which consent text version the user accepted, and when.
  consentVersion      String?
  consentAt           DateTime?
  reputationTier      ReputationTier  @default(NEWCOMER)
  totalPledgedHalalas BigInt          @default(0)
  locale              String          @default("ar")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  projects            Project[]       @relation("ProjectCreator")
  pledges             Pledge[]
  comments            Comment[]
  notifications       Notification[]
  supplierBids        SupplierBid[]
  addresses           Address[]
  payouts             Payout[]        @relation("PayoutCreator")
  contestWins         ContestWinner[]
  faqQuestions        FaqQuestion[]   @relation("FaqAsker")
  creatorProfile      CreatorProfile?
  follows             CreatorFollow[] @relation("Follower")
  updateLikes         UpdateLike[]
  payoutBeneficiary   PayoutBeneficiary?

  @@index([reputationTier])
  @@index([email])
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  name      String
  address   String
  city      String
  country   String   @default("SA")
  postal    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// PROJECTS / REWARDS
// ============================================================================

model Project {
  id                   String          @id @default(uuid()) @db.Uuid
  titleAr              String
  shortDescAr          String
  category             ProjectCategory
  storyAr              String          @db.Text
  mediaUrls            String[]        @default([])
  fundingGoalHalalas   BigInt
  releaseThresholdPct  Int             @default(80)
  durationDays         Int
  deadline             DateTime
  status               ProjectStatus   @default(DRAFT)
  productSpecAr        String?         @db.Text
  expectedDeliveryDate DateTime?
  createdById          String          @db.Uuid
  createdBy            User            @relation("ProjectCreator", fields: [createdById], references: [id])
  raisedHalalas        BigInt          @default(0)
  backersCount         Int             @default(0)
  /// §7 — Wathba-as-co-founder marker. Null = normal community project.
  platformPartner      Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  publishedAt          DateTime?
  /// Admin review feedback surfaced to the creator on reject (Creator-CC /
  /// CC-04). Previously the reject reason was discarded; now it is persisted
  /// and shown in the dashboard so the creator can fix and resubmit.
  reviewFeedback       String?         @db.Text
  reviewedAt           DateTime?
  /// Pause/unpause (Creator-CC / CC-14). `pausedAt` is set while status=PAUSED;
  /// `pausedMsAccrued` accumulates total paused time across pause periods and is
  /// capped at 7 days per campaign. The deadline clock keeps running while paused
  /// (policy §5), so pausing only freezes NEW pledges — it never extends the
  /// deadline.
  pausedAt             DateTime?
  pausedMsAccrued      BigInt          @default(0)

  rewardTiers          RewardTier[]
  addOns               AddOn[]
  pledges              Pledge[]
  milestones           Milestone[]
  spendLogs            SpendLog[]
  rfqs                 RFQ[]
  updates              ProjectUpdate[]
  comments             Comment[]
  payouts              Payout[]
  contests             Contest[]
  faqItems             FaqItem[]
  faqQuestions         FaqQuestion[]
  communityStats       CommunityStat[]
  changeLogs           ProjectChangeLog[]

  // Hot-path query indexes:
  //  - (status, deadline)        → deadline scheduler tick
  //  - (status, publishedAt)     → "newest" sort on /projects/discover
  //  - (category, status)        → category filter + LIVE projects
  //  - (status, raisedHalalas)   → "most-funded" sort
  //  - (status, backersCount)    → "most-backers" sort
  //  - (platformPartner)         → §7 partner filter (gin/jsonb? for boolean lookups)
  @@index([status, deadline])
  @@index([status, publishedAt])
  @@index([category, status])
  @@index([status, raisedHalalas])
  @@index([status, backersCount])
  @@index([createdById])
}

model RewardTier {
  id                      String     @id @default(uuid()) @db.Uuid
  projectId               String     @db.Uuid
  project                 Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titleAr                 String
  amountHalalas           BigInt
  descAr                  String     @db.Text
  includesPhysicalProduct Boolean    @default(false)
  requiresShipping        Boolean    @default(false)
  estDeliveryDate         DateTime
  limitQty                Int?
  claimedQty              Int        @default(0)
  popular                 Boolean    @default(false)
  featured                Boolean    @default(false)
  /// CC-13 — a closed tier is hidden from new pledges (existing backers keep it).
  isActive                Boolean    @default(true)
  /// CC-13 — time-boxed early-bird price: while now < earlyBirdUntil and stock
  /// remains, the effective minimum pledge is earlyBirdAmountHalalas.
  earlyBirdAmountHalalas  BigInt?
  earlyBirdUntil          DateTime?
  /// [{nameAr, qty, thumbnailUrl}] — the "ما يتضمنه" line items.
  includedItems           Json       @default("[]")
  /// ISO 3166-1 alpha-2 country codes the creator ships physical rewards to.
  shipsTo                 String[]   @default([])
  sortOrder               Int        @default(0)
  createdAt               DateTime   @default(now())

  pledges                 Pledge[]
  contestPrizes           Contest[]  @relation("ContestPrizeRewardTier")

  // (projectId, sortOrder) → ordered tier list for the project page.
  @@index([projectId, sortOrder])
  @@index([projectId, featured])
}

// Optional pledge add-ons (stacked onto a backer's tier choice). Limited
// stock supported via limitQty/claimedQty.
model AddOn {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titleAr       String
  amountHalalas BigInt
  descAr        String   @db.Text
  imageUrl      String?
  limitQty      Int?
  claimedQty    Int      @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  pledgeAddOns  PledgeAddOn[]
  contestPrizes Contest[] @relation("ContestPrizeAddOn")

  @@index([projectId, sortOrder])
}

model PledgeAddOn {
  id            String  @id @default(uuid()) @db.Uuid
  pledgeId      String  @db.Uuid
  pledge        Pledge  @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  addOnId       String  @db.Uuid
  addOn         AddOn   @relation(fields: [addOnId], references: [id])
  qty           Int     @default(1)
  amountHalalas BigInt
  createdAt     DateTime @default(now())

  @@index([pledgeId])
  @@index([addOnId])
}

// ============================================================================
// FUNDING / PLEDGES
// ============================================================================

model Pledge {
  id            String       @id @default(uuid()) @db.Uuid
  backerId      String       @db.Uuid
  backer        User         @relation(fields: [backerId], references: [id])
  projectId     String       @db.Uuid
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tierId        String       @db.Uuid
  tier          RewardTier   @relation(fields: [tierId], references: [id])
  amountHalalas BigInt
  /// Sum of add-on amounts (sub-total) — convenience cache, recomputed on add-on change.
  addOnsHalalas BigInt       @default(0)
  status        PledgeStatus @default(HELD)
  /// Creator-editable fulfillment bookkeeping (Creator-CC / CC-02). No money
  /// effect — never read by any capture/refund/payout path.
  rewardStatus  RewardFulfillmentStatus @default(PENDING)
  shipping      Json?
  contractType  ContractType @default(DONATION)
  paymentRef    String       @unique
  /// Per-project sequential backer number (#1, #2 …). Assigned in the pledge tx.
  /// Lets us reference backers in contest winner announcements without
  /// exposing user IDs. Always set since migration 0002_backfill_pledge_backerno
  /// (legacy NULLs were backfilled in createdAt order per project).
  backerNo      Int
  createdAt     DateTime     @default(now())
  capturedAt    DateTime?
  refundedAt    DateTime?

  addOns        PledgeAddOn[]
  materialised  CommunityMaterialised?

  // (projectId, status)      → funding aggregations
  // (backerId, createdAt)    → /v1/pledges/me chronological list
  // (backerId, status)       → "my held / captured / refunded" filters
  // (projectId, backerNo)    → look up backer by # for contest announcements
  // (projectId, rewardStatus)→ backer-roster fulfillment filter (CC-02)
  @@unique([projectId, backerNo])
  @@index([projectId, status])
  @@index([backerId, createdAt])
  @@index([backerId, status])
  @@index([projectId, rewardStatus])
}

// ============================================================================
// MILESTONES + TRANSPARENCY
// ============================================================================

model Milestone {
  id               String          @id @default(uuid()) @db.Uuid
  projectId        String          @db.Uuid
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order            Int
  titleAr          String
  releasePct       Int
  evidenceRequired String          @db.Text
  status           MilestoneStatus @default(PENDING)
  releasedHalalas  BigInt          @default(0)
  submittedAt      DateTime?
  approvedAt       DateTime?
  releasedAt       DateTime?
  evidenceUrl      String?

  spendLogs        SpendLog[]
  payouts          Payout[]

  @@unique([projectId, order])
  @@index([projectId])
}

model SpendLog {
  id            String     @id @default(uuid()) @db.Uuid
  projectId     String     @db.Uuid
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId   String?    @db.Uuid
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  amountHalalas BigInt
  descAr        String     @db.Text
  date          DateTime
  proofUrl      String?
  createdAt     DateTime   @default(now())

  @@index([projectId, date])
}

// ============================================================================
// PROCUREMENT
// ============================================================================

model RFQ {
  id           String        @id @default(uuid()) @db.Uuid
  projectId    String        @db.Uuid
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specsAr      String        @db.Text
  dueDate      DateTime
  status       RFQStatus     @default(OPEN)
  awardedBidId String?       @db.Uuid
  createdAt    DateTime      @default(now())
  bids         SupplierBid[]

  @@index([projectId])
  @@index([status, dueDate])
}

model SupplierBid {
  id                 String    @id @default(uuid()) @db.Uuid
  rfqId              String    @db.Uuid
  rfq                RFQ       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId         String    @db.Uuid
  supplier           User      @relation(fields: [supplierId], references: [id])
  amountHalalas      BigInt
  leadTimeDays       Int
  specComplianceNote String    @db.Text
  status             BidStatus @default(SUBMITTED)
  createdAt          DateTime  @default(now())

  // (rfqId, status, amountHalalas) → sorted bid table for the RFQ owner
  // (supplierId, createdAt)        → "my bids" chronological list
  @@index([rfqId, status, amountHalalas])
  @@index([rfqId])
  @@index([supplierId, createdAt])
}

// ============================================================================
// PAYOUTS
// ============================================================================

model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId      String       @db.Uuid
  creator        User         @relation("PayoutCreator", fields: [creatorId], references: [id])
  amountHalalas  BigInt
  milestoneId    String       @db.Uuid
  milestone      Milestone    @relation(fields: [milestoneId], references: [id])
  status         PayoutStatus @default(PENDING)
  zatcaInvoiceId String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  // (creatorId, status, createdAt) → wallet view (SENT vs PENDING ordering)
  // (projectId, status)             → admin payouts queue
  @@index([projectId, status])
  @@index([creatorId, status, createdAt])
}

// ============================================================================
// UPDATES / COMMENTS / NOTIFICATIONS
// ============================================================================

model ProjectUpdate {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titleAr       String
  bodyAr        String   @db.Text
  /// Numbered update order (#1, #2 …) — manually assigned by the creator.
  /// Highest is "latest" on the campaign page.
  orderNum      Int      @default(0)
  /// Materialised count over UpdateLike — updated atomically with insert /
  /// delete in UpdatesService.like() so it stays in sync with the join rows.
  likeCount     Int      @default(0)
  commentCount  Int      @default(0)
  date          DateTime @default(now())
  /// CC-12 — creator-pinned update floats to the top of the list.
  pinned        Boolean  @default(false)
  pinnedAt      DateTime?
  /// CC-12 — PUBLIC or BACKERS_ONLY (CAPTURED backers, policy §9).
  visibility    UpdateVisibility @default(PUBLIC)
  /// CC-12 — scheduled publish time. The public list hides updates until
  /// publishAt <= now; the fan-out notification fires when it becomes due.
  publishAt     DateTime @default(now())
  /// Set once the CC-01 fan-out has run for this update (guards scheduled fan-out).
  notifiedAt    DateTime?

  likes         UpdateLike[]

  @@index([projectId, date])
  @@index([projectId, orderNum])
  @@index([projectId, pinned, publishAt])
}

/// Per-user like join — kills the double-like exploit on /v1/updates/:id/like.
/// Tier 3.4. likeCount on ProjectUpdate stays as a denormalised counter for
/// list rendering speed; the join row is the source of truth.
model UpdateLike {
  updateId  String        @db.Uuid
  update    ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([updateId, userId])
  @@index([userId])
}

/// Idempotency guard for CommunityService.materializeFromPledge — Tier 3.5.
/// Before incrementing aggregates we insert a row keyed on the pledge id;
/// the PK clash on a worker retry tells us "already counted, skip".
model CommunityMaterialised {
  pledgeId  String   @id @db.Uuid
  pledge    Pledge   @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  appliedAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  bodyAr    String   @db.Text
  parentId  String?  @db.Uuid
  /// Cached: comment author is the project creator. Drives the "Creator"
  /// badge on the public page. Recomputed if creator changes (shouldn't).
  isCreator Boolean  @default(false)
  /// Creator-pinned: floats to top of the list.
  pinned    Boolean  @default(false)
  pinnedAt  DateTime?
  /// Moderator hidden — shown as "removed" placeholder, body suppressed.
  hidden    Boolean  @default(false)
  likeCount Int      @default(0)
  date      DateTime @default(now())

  // (projectId, parentId, date) → cursor pagination of top-level vs replies
  // (userId, date)              → user activity feed
  // (projectId, pinned)         → fast pinned-first ordering
  @@index([projectId, parentId, date])
  @@index([projectId, date])
  @@index([userId, date])
  @@index([projectId, pinned, date])
}

// ============================================================================
// CONTESTS — "علّق واربح" (Comment & Win) engagement rounds.
// ============================================================================

model Contest {
  id                  String        @id @default(uuid()) @db.Uuid
  projectId           String        @db.Uuid
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Sequential round number for this project (الجولة 1، 2 …).
  roundNum            Int
  promptAr            String        @db.Text
  /// Prize is one of: a RewardTier, an AddOn, or a custom free-text label.
  prizeRewardTierId   String?       @db.Uuid
  prizeRewardTier     RewardTier?   @relation("ContestPrizeRewardTier", fields: [prizeRewardTierId], references: [id])
  prizeAddOnId        String?       @db.Uuid
  prizeAddOn          AddOn?        @relation("ContestPrizeAddOn", fields: [prizeAddOnId], references: [id])
  prizeCustomAr       String?
  winnersCount        Int
  status              ContestStatus @default(DRAFT)
  startsAt            DateTime?
  endsAt              DateTime?
  announcedAt         DateTime?
  /// Pinned creator comment auto-posted on announce — id for later edit/unpin.
  announcementCommentId String?     @db.Uuid
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  winners             ContestWinner[]

  @@unique([projectId, roundNum])
  @@index([projectId, status])
}

model ContestWinner {
  id        String   @id @default(uuid()) @db.Uuid
  contestId String   @db.Uuid
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  backerId  String   @db.Uuid
  backer    User     @relation(fields: [backerId], references: [id])
  /// Snapshot of backer's per-project backerNo at announce time
  /// (the # displayed publicly — "الداعم رقم #1234").
  backerNo  Int
  createdAt DateTime @default(now())

  @@unique([contestId, backerId])
  @@index([contestId])
}

// ============================================================================
// FAQ
// ============================================================================

model FaqItem {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questionAr String
  answerAr   String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, sortOrder])
}

/// Incoming question from a logged-in user ("اسأل المبدع").
/// Creator answers from the dashboard; when ANSWERED, an FaqItem is created
/// and the question is linked to it.
model FaqQuestion {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String            @db.Uuid
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  askerId           String?           @db.Uuid
  asker             User?             @relation("FaqAsker", fields: [askerId], references: [id])
  bodyAr            String            @db.Text
  status            FaqQuestionStatus @default(PENDING)
  answeredFaqItemId String?           @db.Uuid
  createdAt         DateTime          @default(now())

  @@index([projectId, status, createdAt])
}

// ============================================================================
// COMMUNITY STATS — per-project aggregates for the Community tab.
// Materialized on pledge events; read-mostly so we keep it denormalised.
// ============================================================================

model CommunityStat {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @db.Uuid
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scope     CommunityStatScope
  /// City name (Arabic), ISO-3166 alpha-2 country code, or one of
  /// 'NEW' / 'RETURNING' / 'TOTAL' when scope = TOTALS.
  key       String
  backers   Int                @default(0)

  @@unique([projectId, scope, key])
  @@index([projectId, scope, backers])
}

/// Public transparency change-log (Creator-CC / CC-11 + CC-13). One row per
/// post-launch content change the creator makes to a LIVE campaign (story edit,
/// reward-tier copy fix). Publicly visible so backers can see what changed after
/// they pledged. Append-only.
model ProjectChangeLog {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  /// 'story' | 'reward-tier' | 'media' …
  field     String
  /// Human-readable Arabic summary shown to backers.
  summaryAr String   @db.Text
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// ============================================================================
// CREATOR PROFILE — public, denormalised over User. One row per creator.
// ============================================================================

model CreatorProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl            String?
  bioAr                String?  @db.Text
  websiteUrl           String?
  /// [{nameAr, role, avatarUrl}] — the collaborators / partners list.
  collaborators        Json     @default("[]")
  followersCount       Int      @default(0)
  createdProjectsCount Int      @default(0)
  backedProjectsCount  Int      @default(0)
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  follows              CreatorFollow[]
}

model CreatorFollow {
  id               String         @id @default(uuid()) @db.Uuid
  followerId       String         @db.Uuid
  follower         User           @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([followerId, creatorProfileId])
  @@index([creatorProfileId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  payload   Json
  /// Optional idempotency guard (Creator-CC / CC-01). For fan-out kinds
  /// (e.g. UPDATE_POSTED) set to `update:{updateId}:{userId}` so a re-publish
  /// or retry can't double-notify. Null for one-off notifications (Postgres
  /// allows many NULLs under a UNIQUE constraint).
  dedupKey  String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // (userId, readAt)    → unread-only filters
  // (userId, createdAt) → chronological inbox
  @@index([userId, readAt])
  @@index([userId, createdAt])
}


/// Inbound PSP webhook deliveries — idempotency ledger for async payment
/// truth (Sprint 1 / P0-003). One row per unique delivery; `dedupKey`
/// makes replays and Moyasar's at-least-once retries harmless.
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @default("moyasar")
  eventType   String
  pspRef      String
  dedupKey    String    @unique
  payload     Json
  processedAt DateTime?
  /// applied | ignored | duplicate | mismatch
  outcome     String?
  createdAt   DateTime  @default(now())

  // (pspRef) → reconciliation lookups by payment id
  @@index([pspRef])
  @@index([createdAt])
}

enum LedgerEntryType {
  HOLD_AUTHORIZED
  CAPTURE
  VOID
  REFUND
  PAYOUT_SENT
  DISPUTE
}

/// Append-only money journal (Sprint 1 / P1-602). One row per PSP-side
/// money movement, written in the same code path that performs it. This is
/// the reconciliation source of truth: every row maps to a real PSP event
/// via `pspRef`. Never UPDATE or DELETE rows here.
model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  entryType     LedgerEntryType
  amountHalalas BigInt
  pspRef        String
  pledgeId      String?         @db.Uuid
  payoutId      String?         @db.Uuid
  projectId     String?         @db.Uuid
  /// origin of the write: sync-path | webhook | disburser
  source        String          @default("sync-path")
  createdAt     DateTime        @default(now())

  @@index([pspRef])
  @@index([projectId, createdAt])
  @@index([pledgeId])
  @@index([entryType, createdAt])
}

/// ZATCA Phase-2 e-invoice on the platform commission (Sprint 2 / P0-701).
/// One simplified tax invoice per payout tranche: Wathba invoices the
/// creator 5% commission + 15% VAT, with the Phase-1 TLV QR embedded and a
/// Phase-2 reporting timestamp once cleared.
model ZatcaInvoice {
  id                 String    @id @default(uuid()) @db.Uuid
  invoiceNumber      String    @unique
  payoutId           String    @unique @db.Uuid
  creatorId          String    @db.Uuid
  commissionHalalas  BigInt
  vatHalalas         BigInt
  totalHalalas       BigInt
  qrTlv              String
  payload            Json
  issuedAt           DateTime  @default(now())
  reportedAt         DateTime?

  @@index([creatorId, issuedAt])
}

/// Immutable audit trail for privileged + money-critical actions
/// (Sprint 2 / P1-503). Append-only; never UPDATE or DELETE.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// Rotating refresh tokens (Sprint 2 / P1-502). Only the SHA-256 of the
/// token is stored. Rotation revokes the old row and links its successor;
/// presenting an already-revoked token is treated as replay → all of the
/// user's sessions are revoked.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
}

/// One-time password-reset tokens (Sprint 3 / P1-206). SHA-256 stored,
/// 30-minute TTL, single use; a successful reset revokes every refresh
/// token the account holds.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum BeneficiaryType {
  BANK_ACCOUNT
  WALLET
}

/// Creator payout beneficiary (Sprint 5 / #7) — the Moyasar `destination`
/// for real payouts. One per creator; PDPL-relevant PII. `moyasarAccountId`
/// is set once the beneficiary is registered as a Moyasar payout account
/// (credential-gated). A payout cannot be disbursed without a row here.
model PayoutBeneficiary {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            BeneficiaryType @default(BANK_ACCOUNT)
  iban            String?
  name            String
  mobile          String
  country         String          @default("SA")
  city            String?
  moyasarAccountId String?
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}
